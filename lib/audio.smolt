const AUDIO_NOTE_EMPTY = -1
const AUDIO_NOTE_OFF   = -2

const AUDIO_ENV_RELEASE = 0
const AUDIO_ENV_ATTACK  = 1
const AUDIO_ENV_DECAY   = 2
const AUDIO_ENV_PEAK    = 256 * 64

# a voice plays an instrument (music) or a sound effect: envelope, wave, pitch, pw and vibrato,
# driven by a command string like "v50 d8 P=60|,+3,"
struct AudioVoice:
    pos: int*
    loop: int*
    wait
    length
    env
    level
    attack
    decay
    sustain
    release
    vol
    wave
    filter      # 1 LP | 2 BP | 4 HP, 0 = dry
    cutoff      # 0..1023
    cutoff_rate
    pitch       # 1/8 semitones
    abs_pitch   # music only: ignore the note pitch
    pw
    pw_rate
    vib_pos
    vib_rate
    vib_depth
    priority    # sfx only: see audio_play_sfx

# one row of a track, up to ','. note, porta and jump are per row, the rest carries over
struct AudioRow:
    note
    porta_start
    porta_speed
    instr
    jump        # j: run this instrument on the playing note, -1 = none
    octave
    volume
    quant
    wait

struct AudioTrack:
    index
    pos: int*
    loop: int*
    row: AudioRow   # playing
    next: AudioRow  # read ahead, to release the note early if the next row has a new one

    porta_speed
    pitch
    pitch_target

    wait
    voice: AudioVoice

var audio_instruments: int*[100]
var audio_tracks: AudioTrack[8]   # @i plays on APU voice 7 - i
var audio_sfx: AudioVoice[8]      # @i plays on APU voice i, over the music
var audio_music_volume = 64
var audio_sfx_volume   = 64


func audio_skip_space(p: int**):
    while p.*.* == ' ' or p.*.* == '\n': p.* += 1

func audio_skip_line(p: int**):
    while p.*.* and p.*.* != '\n': p.* += 1
    if p.*.*: p.* += 1

func audio_read_num(p: int**) int:
    var n = 0
    var minus = false
    while p.*.* == '-':
        minus = not minus
        p.* += 1
    while p.*.* >= '0' and p.*.* <= '9':
        n = n * 10 + p.*.* - '0'
        p.* += 1
    audio_skip_space(p)
    return minus ? -n : n


func audio_stop_music():
    for n in audio_instruments: n.* = null
    for t in audio_tracks: t.* = {}

func audio_play_music(p: int*):
    audio_stop_music()

    while p.*:
        var c = p.*
        p += 1
        if c == '#': audio_skip_line(p)
        elif c == '$':
            var i = audio_read_num(p)
            if i < audio_instruments.len: audio_instruments[i] = p
        elif c == '@':
            var i = audio_read_num(p)
            if i < audio_tracks.len:
                var s = &audio_tracks[i]
                if s.pos: continue
                s.pos         = p
                s.index       = i
                s.next.volume = 64
                s.next.octave = 4
        elif c == '%': for s in audio_tracks: s.pos = null
    for s in audio_tracks: audio_track_read_row(s)


func audio_voice_start(v: AudioVoice*, p: int*):
    v.pos       = p
    v.loop      = null
    v.wait      = 0
    v.length    = 0
    v.env       = AUDIO_ENV_ATTACK
    v.level     = 0
    v.attack    = AUDIO_ENV_PEAK
    v.decay     = 0
    v.sustain   = 0
    v.release   = 0
    v.vol       = 64
    v.filter    = 0
    v.cutoff_rate = 0
    v.pitch     = 0
    v.abs_pitch = false
    v.vib_pos   = 0
    v.vib_rate  = 0
    v.vib_depth = 0

func audio_env_step(rate) int: return AUDIO_ENV_PEAK / (1 + (rate + 8) * rate * 15 / 128)

func audio_voice_update(v: AudioVoice*):
    v.pw += v.pw_rate
    v.pw %= 1024
    v.cutoff = clamp(v.cutoff + v.cutoff_rate, 0, 1023)
    v.vib_pos += v.vib_rate
    v.vib_pos %= 256

    if v.pos:
        if v.wait <= 0:
            while true:
                var c = v.pos.*
                v.pos += 1
                if   c == ' ':
                elif c == 'v': v.vol       = audio_read_num(v.pos)
                elif c == 'l': v.length    = audio_read_num(v.pos)
                elif c == 'a': v.attack    = audio_env_step(audio_read_num(v.pos))
                elif c == 'd': v.decay     = AUDIO_ENV_PEAK - audio_env_step(audio_read_num(v.pos))
                elif c == 'r': v.release   = AUDIO_ENV_PEAK - audio_env_step(audio_read_num(v.pos))
                elif c == 's': v.sustain   = audio_read_num(v.pos) * AUDIO_ENV_PEAK / 64
                elif c == 'W': v.pw        = audio_read_num(v.pos) * 4
                elif c == 'w': v.pw_rate   = audio_read_num(v.pos)
                elif c == 'Y': v.vib_depth = audio_read_num(v.pos)
                elif c == 'y': v.vib_rate  = audio_read_num(v.pos)
                elif c == 'T': v.wave      = WAVE_TRI
                elif c == 'S': v.wave      = WAVE_SAW
                elif c == 'P': v.wave      = WAVE_PULSE
                elif c == 'N': v.wave      = WAVE_NOISE
                elif c == 'F': v.filter    = audio_read_num(v.pos)
                elif c == 'C': v.cutoff    = audio_read_num(v.pos)
                elif c == 'c': v.cutoff_rate = audio_read_num(v.pos)
                elif c == '=' or c == '~':
                    v.pitch     = audio_read_num(v.pos) * 8
                    v.abs_pitch = c == '='
                elif c == '+': v.pitch += audio_read_num(v.pos) * 8
                elif c == 'f': v.pitch += audio_read_num(v.pos)
                elif c == '|': v.loop = v.pos
                elif c == ',':
                    v.wait = audio_read_num(v.pos) ?: 1
                    break
                else:
                    v.pos = v.loop
                    if not v.pos:
                        break
        v.wait -= 1

    # adsr
    if v.env == AUDIO_ENV_ATTACK:
        v.level = min(v.level + v.attack, AUDIO_ENV_PEAK)
        if v.level == AUDIO_ENV_PEAK: v.env = AUDIO_ENV_DECAY
    if v.env == AUDIO_ENV_DECAY: v.level = v.sustain + (v.level - v.sustain) * v.decay / AUDIO_ENV_PEAK
    if v.env == AUDIO_ENV_RELEASE: v.level = v.level * v.release / AUDIO_ENV_PEAK

    if v.length:
        v.length -= 1
        if not v.length: v.env = AUDIO_ENV_RELEASE

func audio_voice_vibrato(v: AudioVoice*) int:
    if not v.vib_depth: return 0
    var x = abs(((v.vib_pos + 64) & 255) - 128)
    return (x * v.vib_depth + 32) / 64 - v.vib_depth

# read the next row into t.next. returns false at the end of the track
func audio_track_read_row(t: AudioTrack*) int:
    if not t.pos: return false
    var r = &t.next
    r.note        = AUDIO_NOTE_EMPTY
    r.porta_start = AUDIO_NOTE_EMPTY
    r.porta_speed = 0
    r.jump        = -1
    while true:
        var c = t.pos.*
        t.pos += 1
        if   c == ' ' or c == '\n':
        elif c == '#': audio_skip_line(t.pos)
        elif c == '|': t.loop = t.pos
        elif c == 'v': r.volume = audio_read_num(t.pos)
        elif c == 'q': r.quant  = audio_read_num(t.pos)
        elif c == 'i': r.instr  = audio_read_num(t.pos)
        elif c == 'j': r.jump   = audio_read_num(t.pos)
        elif c == '*':
            r.porta_speed = audio_read_num(t.pos) ?: 9999
            r.porta_start = r.note
        elif c == 'o': r.octave = audio_read_num(t.pos)
        elif c == '<': r.octave -= 1
        elif c == '>': r.octave += 1
        elif c == '\'': r.note += 12
        elif c == '+': r.note += 1
        elif c == '-': r.note -= 1
        elif c == '=': r.note = AUDIO_NOTE_OFF
        elif c >= 'a' and c <= 'g': r.note = stridx("c d ef g a b", c) + 12 * r.octave
        elif c == 't': r.wait = audio_read_num(t.pos)
        elif c == ',':
            r.wait = audio_read_num(t.pos) ?: r.wait
            return true
        else:
            # skip
            while true:
                if c == '\0':
                    t.pos = t.loop
                    if not t.pos: return false
                    break
                if c == '@' and audio_read_num(t.pos) == t.index: break
                if c == '#': audio_skip_line(t.pos)
                c = t.pos.*
                t.pos += 1


func audio_track_update(t: AudioTrack*):
    var v = &t.voice
    var n = &t.next
    if not t.pos and t.wait <= 0: v.env = AUDIO_ENV_RELEASE   # ended (or unused)
    else:
        if t.wait == t.row.quant and n.note != AUDIO_NOTE_EMPTY and n.porta_speed == 0: v.env = AUDIO_ENV_RELEASE
        if t.wait <= 0:
            t.row  = t.next
            t.wait = n.wait
            if n.note >= 0:
                t.pitch_target = n.note * 64
                if n.porta_start >= 0 or n.porta_speed == 0:
                    t.pitch = n.porta_start >= 0 ? n.porta_start * 64 : t.pitch_target
                    audio_voice_start(v, audio_instruments[n.instr])
            if n.jump >= 0:
                v.pos  = audio_instruments[n.jump]
                v.loop = null
                v.wait = 0
            if n.note != AUDIO_NOTE_EMPTY: t.porta_speed = n.porta_speed
            audio_track_read_row(t)
        t.wait -= 1

    if t.pitch != t.pitch_target:
        t.pitch = clamp(t.pitch_target, t.pitch - t.porta_speed, t.pitch + t.porta_speed)
    audio_voice_update(v)


func audio_sfx_voice_free(v: AudioVoice*) int:
    return not v.pos or v.env != AUDIO_ENV_ATTACK and v.level < AUDIO_ENV_PEAK / 2

func audio_play_sfx(p: int*):
    while p.*:
        var c = p.*
        p += 1
        if c == '#': audio_skip_line(p)
        elif c == '@':
            var i = audio_read_num(p)
            var priority = 1
            if p.* == '!':
                p += 1
                priority = audio_read_num(p)
            if i < audio_sfx.len and (priority >= audio_sfx[i].priority or audio_sfx_voice_free(audio_sfx[i])):
                audio_sfx[i] = {}
                audio_sfx[i].priority = priority
                audio_voice_start(&audio_sfx[i], p)

func audio_update():
    for i = 0, 8:
        var t = &audio_tracks[7 - i]
        audio_track_update(t)

        # a playing sfx takes the APU voice; the music on it plays on silently
        var v     = &t.voice
        var pitch = v.abs_pitch ? 0 : t.pitch / 8
        var gain  = t.row.volume * audio_music_volume   # 64 * 64: full
        if audio_sfx[i].pos:
            v     = &audio_sfx[i]
            pitch = 0
            gain  = audio_sfx_volume * 64
            audio_voice_update(v)

        # set APU registers
        sound(i, pitch + v.pitch + audio_voice_vibrato(v), v.pw, v.level * v.vol / 64 * gain / $10000, v.wave)
        filter(i, v.filter, v.cutoff)
