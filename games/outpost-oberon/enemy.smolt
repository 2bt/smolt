const ENEMY_STATE_DEAD   = 0
const ENEMY_STATE_NORMAL = 1
const ENEMY_STATE_DYING  = 2

const ENEMY_TYPE_PATROL  = 1
const ENEMY_TYPE_BUGGER  = 2
const ENEMY_TYPE_CANNON  = 3
const ENEMY_TYPE_JELLY   = 4
const ENEMY_TYPE_PINATA  = 5
const ENEMY_TYPE_CRAWLER = 6
const ENEMY_TYPE_MINE    = 7

const ENEMY_BULLET_TYPE_BASIC = 1
const ENEMY_BULLET_TYPE_AIMED = 2
const ENEMY_BULLET_TYPE_ORB   = 3   # big and round: the mine's burst


# ---------------------------------------------------------------------------
# bullets
# ---------------------------------------------------------------------------

struct EnemyBullet:
    alive
    type
    box: Box
    sx
    sy
    vx
    vy

var enemy_bullets: EnemyBullet[32]   # room for a few mine bursts

# x,y = top-left of hit box
func enemy_bullet_spawn(type, x, y) EnemyBullet*:
    for b in enemy_bullets:
        if b.alive: continue
        b.* = {}
        b.alive = true
        b.type = type
        if type == ENEMY_BULLET_TYPE_BASIC:
            b.box.w = 6
            b.box.h = 1
        elif type == ENEMY_BULLET_TYPE_ORB:
            b.box.w = 6
            b.box.h = 6
        else:
            b.box.w = 2
            b.box.h = 2
        b.box.x = x
        b.box.y = y
        b.sx = x * SP
        b.sy = y * SP
        return b
    return null

func enemy_bullet_update_all():
    var view = camera.box
    box_grow(view, 8)

    for b in enemy_bullets:
        if not b.alive: continue
        if not box_intersects(view, b.box):
            b.alive = 0
            continue

        var hit_x = level_move_box_x(&b.sx, &b.box, b.vx)
        var hit_y = level_move_box_y(&b.sy, &b.box, b.vy, true)
        if hit_x or hit_y:
            b.alive = false
            # the bullet's front pixel; the wall is one pixel further
            var px = box_center_x(b.box)
            var py = box_center_y(b.box)
            if hit_x == DIR_LEFT:  px = b.box.x
            if hit_x == DIR_RIGHT: px = b.box.x + b.box.w - 1
            if hit_y == DIR_UP:    py = b.box.y
            if hit_y == DIR_DOWN:  py = b.box.y + b.box.h - 1
            level_hit_block(px + (hit_x == DIR_RIGHT) - (hit_x == DIR_LEFT),
                            py + (hit_y == DIR_DOWN) - (hit_y == DIR_UP), null)
            particle_spawn(PARTICLE_TYPE_FLASH, px, py)
            audio_play_sfx(SFX_BULLET_WALL)
            continue

        if hero_can_take_damage() and box_intersects(b.box, hero.box):
            b.alive = false
            hero_hurt()
            continue

func enemy_bullet_draw_all():
    for b in enemy_bullets:
        if not b.alive: continue
        if b.type == ENEMY_BULLET_TYPE_BASIC:
            camera_sprite(b.box.x, b.box.y, 6, 1, 0, 32 + 1, 0)
        elif b.type == ENEMY_BULLET_TYPE_AIMED:
            for i = 0, 4:
                var x = (b.sx - b.vx * i) / SP
                var y = (b.sy - b.vy * i) / SP
                camera_sprite(x, y, 2, 2, 32, 32, 0)
        elif b.type == ENEMY_BULLET_TYPE_ORB:
            camera_sprite(b.box.x, b.box.y, 6, 6, level.tick / 4 % 3 * 8, 336, 0)

# ---------------------------------------------------------------------------
# enemies
# ---------------------------------------------------------------------------

struct Enemy:
    state
    active
    box: Box
    type
    sx
    sy
    hp

    facing_left
    frame
    hit_countdown

    # movement (bugger; patrol leaves unused)
    mode
    vx
    vy
    on_ground   # standing on something; moving platforms carry it
    ground_frames
    no_turn_countdown

    # patrol / bugger timers (bugger: wait = sleep / turn / land pause;
    # pace = loc-lost / stroll)
    anim_tick
    wait_countdown
    wait_turn
    pace_countdown
    shoot_countdown
    burst_left
    aim_countdown

    # jelly
    charge: Particle*

    # piñata: turns around this far from its spawn point
    home_sx

    # crawler: travel direction (unit); mode is the turn sense, +1 clockwise
    crawl_dx
    crawl_dy

var enemies: Enemy[100]


func enemy_init_all():
    for e in enemies: e.* = {}
    for r = 0, level.h:
        for c = 0, level.w:
            var x = c * TS
            var y = r * TS
            var t = level_get_tile_at_cr(c, r)
            if   t == 'p': enemy_spawn(ENEMY_TYPE_PATROL, x, y)
            elif t == 'b': enemy_spawn(ENEMY_TYPE_BUGGER, x, y)
            elif t == 'c': enemy_spawn(ENEMY_TYPE_CANNON, x, y)
            elif t == 'j': enemy_spawn(ENEMY_TYPE_JELLY, x, y)
            elif t == 'o': enemy_spawn(ENEMY_TYPE_PINATA, x, y)
            elif t == 'w': enemy_spawn(ENEMY_TYPE_CRAWLER, x, y)
            elif t >= '1' and t <= '9': enemy_spawn(ENEMY_TYPE_MINE, x, y)

func enemy_spawn(type, x, y):
    for e in enemies:
        if e.state: continue
        e.* = {}
        e.state = ENEMY_STATE_NORMAL
        e.type  = type

        if type == ENEMY_TYPE_PATROL:
            e.box.w           = 8
            e.box.h           = 17
            e.hp              = 4
            e.pace_countdown  = rand(30, 80)
            e.shoot_countdown = rand(0, 100)
            e.on_ground       = true  # spawns standing; platforms carry it before it first updates

        elif type == ENEMY_TYPE_BUGGER:
            e.box.w     = 12
            e.box.h     = 11
            e.hp        = 4
            enemy_bugger_set_mode(e, BUGGER_MODE_SLEEP)

        elif type == ENEMY_TYPE_CANNON:
            e.box.w = 6
            e.box.h = 12
            e.hp    = 6
            e.facing_left = level_get_tile_at_cr(x / TS + 1, y / TS) == '0'
            e.shoot_countdown = rand(30, 90)

        elif type == ENEMY_TYPE_JELLY:
            e.box.w = 10
            e.box.h = 10
            e.hp    = 2
            e.vy    = JELLY_WAVE
            e.shoot_countdown = rand(40, 100)

        elif type == ENEMY_TYPE_PINATA:
            e.box.w = 12
            e.box.h = 12
            e.hp    = PINATA_HP
            e.vy    = PINATA_WAVE

        elif type == ENEMY_TYPE_CRAWLER:
            e.box.w = 10   # square: the same box fits every rotation
            e.box.h = 10
            e.hp    = 3

        elif type == ENEMY_TYPE_MINE:
            e.box.w = 12
            e.box.h = 12
            e.hp    = 6
            e.anim_tick = rand(0, 47)   # out of step with the others: 6 frames of 8 ticks
            # its tile is its direction, laid out like a numpad: 9 is up-right, 5 stays put
            var d = level_get_tile_at_cr(x / TS, y / TS) - '1'
            enemy_mine_set_velocity(&e.vx, &e.vy, d % 3 - 1, 1 - d / 3, MINE_SPEED)


        e.sx = (x + 8 - e.box.w / 2) * SP
        e.sy = (y + 16 - e.box.h) * SP + SP - 1

        if type == ENEMY_TYPE_CANNON:
            e.sy = (y + 8 - e.box.h / 2) * SP
            if e.facing_left: e.sx += 5 * SP
            else:             e.sx -= 5 * SP

        if type == ENEMY_TYPE_JELLY or type == ENEMY_TYPE_PINATA or type == ENEMY_TYPE_MINE:
            e.sy = (y + 8 - e.box.h / 2) * SP
        e.home_sx = e.sx

        if type == ENEMY_TYPE_CRAWLER: enemy_crawler_attach(e, x / TS, y / TS)

        e.box.x = e.sx / SP
        e.box.y = e.sy / SP
        return

    print("error: not enough enemies")



func enemy_update_all():
    var view = camera.box
    box_grow(view, 32)

    for e in enemies:
        if e.state == ENEMY_STATE_DEAD: continue

        if e.state == ENEMY_STATE_DYING:
            e.sx += e.vx
            e.sy += e.vy
            e.box.x = e.sx / SP
            e.box.y = e.sy / SP

            if e.hit_countdown > 5:
                for i = 0, 2:
                    particle_spawn(PARTICLE_TYPE_DEBRIS,
                                   rand(e.box.x, e.box.x + e.box.w - 1),
                                   rand(e.box.y, e.box.y + e.box.h - 1))

            if e.hit_countdown > 0: e.hit_countdown -= 1
            else:
                e.state  = ENEMY_STATE_DEAD
                e.active = false

                # scoring
                hero.score += (
                    e.type == ENEMY_TYPE_PATROL  ? 100 :
                    e.type == ENEMY_TYPE_BUGGER  ? 150 :
                    e.type == ENEMY_TYPE_CANNON  ? 300 :
                    e.type == ENEMY_TYPE_JELLY   ? 200 :
                    e.type == ENEMY_TYPE_PINATA  ? 100 :
                    e.type == ENEMY_TYPE_CRAWLER ? 100 :
                    e.type == ENEMY_TYPE_MINE    ? 150 :
                    1) # should never happen

            continue

        if e.state != ENEMY_STATE_NORMAL: continue


        var prev_active = e.active
        e.active = box_intersects(view, e.box)
        if e.active and not prev_active and e.type != ENEMY_TYPE_CANNON:
            e.facing_left = e.sx > hero.sx
            # crawler on a floor or ceiling: turn around to head for the hero
            if (e.type == ENEMY_TYPE_CRAWLER and e.on_ground and e.crawl_dy == 0
            and (e.crawl_dx < 0) != e.facing_left):
                e.crawl_dx = -e.crawl_dx
                e.mode     = -e.mode

        if e.hit_countdown > 0: e.hit_countdown -= 1

        if e.active:
            if   e.type == ENEMY_TYPE_PATROL: enemy_patrol_update(e)
            elif e.type == ENEMY_TYPE_BUGGER: enemy_bugger_update(e)
            elif e.type == ENEMY_TYPE_CANNON: enemy_cannon_update(e)
            elif e.type == ENEMY_TYPE_JELLY:  enemy_jelly_update(e)
            elif e.type == ENEMY_TYPE_PINATA: enemy_pinata_update(e)
            elif e.type == ENEMY_TYPE_CRAWLER: enemy_crawler_update(e)
            elif e.type == ENEMY_TYPE_MINE:    enemy_mine_update(e)


func enemy_draw_all():
    for e in enemies:
        if not e.active: continue

        if e.state == ENEMY_STATE_DYING and e.hit_countdown & 2: continue

        if e.type == ENEMY_TYPE_PATROL:
            camera_sprite(e.box.x - 4, e.box.y - 15, 16, 32,
                          256 + e.frame * 16,
                          0 + (e.hit_countdown > 0) * 32,
                          e.facing_left)

        elif e.type == ENEMY_TYPE_BUGGER:
            camera_sprite(e.box.x - 2, e.box.y - 5, 16, 16,
                          256 + e.frame * 16,
                          80 + (e.hit_countdown > 0) * 16,
                          e.facing_left)

        elif e.type == ENEMY_TYPE_CANNON:
            var cx = e.facing_left ? e.box.x - 10 : e.box.x
            camera_sprite(cx, e.box.y - 2, 16, 16,
                          256 + e.frame * 16,
                          112 + (e.hit_countdown > 0) * 16,
                          e.facing_left)

        elif e.type == ENEMY_TYPE_JELLY:
            camera_sprite(e.box.x - 3, e.box.y - 3, 16, 16,
                          256 + e.frame * 16,
                          144 + (e.hit_countdown > 0) * 16,
                          0)

        elif e.type == ENEMY_TYPE_PINATA:
            camera_sprite(e.box.x - 2, e.box.y - 2, 16, 16,
                          256 + e.frame * 16,
                          176 + (e.hit_countdown > 0) * 16,
                          0)

        elif e.type == ENEMY_TYPE_MINE:
            camera_sprite(e.box.x - 2, e.box.y - 2, 16, 16,
                          256 + e.frame * 16,
                          240 + (e.hit_countdown > 0) * 16,
                          0)

        elif e.type == ENEMY_TYPE_CRAWLER:
            # art: frame 0 idle, 1-4 walk, on the floor heading right; frames 5-9 the same rotated
            # clockwise (wall on the left, heading down); hit frames 16 below; the 10x10 box hugs
            # the surface side of the 16x16 cell; flips make the ceiling and the right wall
            var gx = -e.crawl_dy * e.mode
            var gy =  e.crawl_dx * e.mode
            var f = gx ? (gx > 0) | (e.crawl_dy < 0) * 2 : (e.crawl_dx < 0) | (gy < 0) * 2
            camera_sprite(e.box.x - 3 - 3 * gx, e.box.y - 3 - 3 * gy, 16, 16,
                          256 + (e.frame + (gx != 0) * 5) * 16,
                          208 + (e.hit_countdown > 0) * 16,
                          f)

        # box
        # camera_sprite(e.box.x, e.box.y, e.box.w, e.box.h, 0, 480, 0)


func enemy_hurt(e: Enemy*, power):
    if e.state != ENEMY_STATE_NORMAL: return
    var hp = e.hp
    e.hp -= power
    e.hit_countdown = 3

    if e.type == ENEMY_TYPE_PATROL:
        if e.aim_countdown == 0:
            e.shoot_countdown /= 2
            if e.facing_left != (box_center_x(e.box) > box_center_x(hero.box)):
                e.wait_countdown = min(10, e.shoot_countdown)
                e.wait_turn      = true

    elif e.type == ENEMY_TYPE_BUGGER:
        enemy_bugger_set_mode(e, BUGGER_MODE_FOLLOW)

    elif e.type == ENEMY_TYPE_PINATA:
        # a quantum for every even hp it reaches going down (6, 4, 2, 0), however the damage is split
        for i = 0, (hp + 1) / 2 - (max(e.hp, 0) + 1) / 2: level_drop_pickup(PICKUP_QUANTUM, box_center_x(e.box), box_center_y(e.box))

    if e.hp <= 0: enemy_kill(e)
    else: audio_play_sfx(SFX_ENEMY_HIT)


func enemy_kill(e: Enemy*):
    e.state = ENEMY_STATE_DYING
    e.hit_countdown = 20
    e.vx = 0
    e.vy = 0
    particle_spawn(PARTICLE_TYPE_EXPLOSION, box_center_x(e.box), box_center_y(e.box))
    audio_play_sfx(SFX_EXPLOSION)
    if e.type == ENEMY_TYPE_MINE: enemy_mine_burst(e)
    if e.type == ENEMY_TYPE_CRAWLER and not e.on_ground: audio_play_sfx(SFX_CRAWLER_HUSH)
    # the piñata bursts; every other enemy drops one
    var n = e.type == ENEMY_TYPE_PINATA ? 2 : 1
    var x = box_center_x(e.box)
    if e.type == ENEMY_TYPE_CANNON: x += e.facing_left ? -4 : 4   # it's thin and flush with its wall
    for i = 0, n: level_drop_pickup(PICKUP_QUANTUM, x, box_center_y(e.box))



# ---------------------------------------------------------------------------
# patrol
# ---------------------------------------------------------------------------

func enemy_patrol_update(e: Enemy*):
    if e.aim_countdown > 0:
        e.frame = 0
    elif e.wait_countdown > 0:
        e.wait_countdown -= 1
        if e.wait_countdown == 0:
            if e.wait_turn: e.facing_left = not e.facing_left
            e.pace_countdown = rand(30, 180)
        e.frame = 0
    else:

        # walk
        var dx = e.facing_left ? -6 : 6
        var hit = level_move_box_x(e.sx, e.box, dx)

        var face_x = e.facing_left ? e.box.x : e.box.x + e.box.w - 1
        var foot_y = e.box.y + e.box.h
        var turn = -1
        if hit or not level_test_down(face_x, foot_y, foot_y - 1):
            turn = 1
        else:
            e.anim_tick += 1
            e.frame = 1 + e.anim_tick / 6 % 4
            e.pace_countdown -= 1
            if e.pace_countdown == 0: turn = rand(0, 4) == 0
        if turn >= 0:
            e.wait_countdown = rand(50, 90)
            e.wait_turn = turn > 0
            e.frame = 0

    # gravity: keeps the feet on whatever is below (e.g. a platform a pixel off)
    e.vy = min(e.vy + GRAVITY, SP * 4)
    e.on_ground = level_move_box_y(e.sy, e.box, e.vy, false) == DIR_DOWN
    if e.on_ground: e.vy = 0

    e.box.x = e.sx / SP
    e.box.y = e.sy / SP


    var muzzle_x = e.facing_left ? e.box.x - 2 : e.box.x + e.box.w + 1
    var muzzle_y = e.box.y + 7
    if e.aim_countdown > 0:
        e.aim_countdown -= 1
        if e.aim_countdown == 19:
            audio_play_sfx(SFX_CHARGE)
            particle_spawn(PARTICLE_TYPE_CHARGE, muzzle_x, muzzle_y)
        if e.aim_countdown == 5:
            var bx = e.facing_left ? muzzle_x : muzzle_x - 5
            var b = enemy_bullet_spawn(ENEMY_BULLET_TYPE_BASIC, bx, muzzle_y)
            if b:
                b.vx = e.facing_left ? -28 : 28
                audio_play_sfx(SFX_PATROL_SHOOT)

        if e.aim_countdown == 0:
            e.burst_left -= 1
            if e.burst_left > 0: e.aim_countdown = 30
            else:
                e.shoot_countdown = rand(60, 200)
                e.burst_left = rand(1, 2)

    elif e.shoot_countdown > 0:
        e.shoot_countdown -= 1

    elif hero.state == HERO_STATE_NORMAL:
        var ex = box_center_x(e.box)
        var ey = box_center_y(e.box)
        var hx = box_center_x(hero.box)
        var hy = box_center_y(hero.box)

        if (e.facing_left == (hx < ex)
        and abs(hy - ey) <= 70
        and box_encloses(camera.box, e.box)
        and (level_has_los(ex, ey, hx, hy) or level_has_los(ex, ey, hx, ey))):
            e.aim_countdown = 20
        else:
            e.shoot_countdown = rand(30, 150)
            e.burst_left = rand(1, 2)


# ---------------------------------------------------------------------------
# bugger
# ---------------------------------------------------------------------------
const BUGGER_MODE_SLEEP  = 0
const BUGGER_MODE_FOLLOW = 1
const BUGGER_MODE_WALK   = 2

const BUGGER_SPEED           = 14
const BUGGER_WALK_SPEED      = 7
const BUGGER_ACCEL           = 1
const BUGGER_WAKE_FRAMES     = 50
const BUGGER_LOC_LOST_FRAMES = 180


func enemy_bugger_set_mode(e: Enemy*, mode):
    e.mode = mode
    e.wait_countdown = 0
    if mode == BUGGER_MODE_SLEEP:
        e.pace_countdown = BUGGER_WAKE_FRAMES
    elif mode == BUGGER_MODE_FOLLOW:
        e.facing_left = box_center_x(e.box) > box_center_x(hero.box)
        e.pace_countdown = BUGGER_LOC_LOST_FRAMES
    elif mode == BUGGER_MODE_WALK:
        e.pace_countdown = rand(60 * 5, 60 * 10)


func enemy_bugger_update(e: Enemy*):

    var hx = box_center_x(hero.box)
    var hy = box_center_y(hero.box)
    var ex = box_center_x(e.box)
    var ey = box_center_y(e.box)
    var loc = (hero.state == HERO_STATE_NORMAL
        and box_encloses(camera.box, e.box)
        and (level_has_los(ex, ey, hx, hy) or level_has_los(ex, ey, hx, ey)))

    if e.mode == BUGGER_MODE_SLEEP:
        if loc:
            e.pace_countdown -= 1
            if e.pace_countdown == 0:
                enemy_bugger_set_mode(e, BUGGER_MODE_FOLLOW)
        else:
            e.pace_countdown = BUGGER_WAKE_FRAMES

    elif e.mode == BUGGER_MODE_FOLLOW:
        if hero.state != HERO_STATE_NORMAL:
            enemy_bugger_set_mode(e, BUGGER_MODE_WALK)
        elif loc:
            e.pace_countdown = BUGGER_LOC_LOST_FRAMES
        else:
            e.pace_countdown -= 1
            if e.pace_countdown == 0:
                enemy_bugger_set_mode(e, BUGGER_MODE_WALK)

    elif e.mode == BUGGER_MODE_WALK:
        if loc:
            enemy_bugger_set_mode(e, BUGGER_MODE_FOLLOW)
        else:
            e.pace_countdown -= 1
            if e.pace_countdown == 0:
                enemy_bugger_set_mode(e, BUGGER_MODE_SLEEP)



    if e.no_turn_countdown > 0: e.no_turn_countdown -= 1
    if e.wait_countdown > 0:
        e.wait_countdown -= 1
        if e.wait_countdown == 0 and e.wait_turn: e.facing_left = not e.facing_left

    if e.on_ground:

        var speed  = 0
        var jump   = 0
        var foot_y = e.box.y + e.box.h
        var foot_x = e.facing_left ? e.box.x : e.box.x + e.box.w - 1


        if e.wait_countdown:
        elif e.mode == BUGGER_MODE_WALK:
            speed = BUGGER_WALK_SPEED
            # turn around on ledge
            if not level_test_down(foot_x, foot_y, foot_y - 1):
                e.wait_countdown = 20
                e.wait_turn      = true

        elif e.mode == BUGGER_MODE_FOLLOW:
            speed = BUGGER_SPEED

            # turn around to hero
            var want_left = hx < ex
            if e.no_turn_countdown <= 0 and want_left != e.facing_left and loc:
                e.wait_countdown = 20
                e.wait_turn      = true

            if e.ground_frames > 15:
                if abs(hx - ex) <= 35 and hero.box.y < ey:
                    # attack
                    jump = 38
                elif abs(e.vx) > BUGGER_SPEED - 3:
                    var wall_x = e.facing_left ? e.box.x - 10 : e.box.x + e.box.w - 1 + 10
                    if want_left == e.facing_left and level_test(wall_x, e.box.y, 0):
                        jump = 38
                    elif not level_test_down(foot_x, foot_y, foot_y - 1):
                        jump = 24
                if jump:
                    e.vy = -jump
                    e.on_ground = false
                    e.ground_frames = 0
                    audio_play_sfx(SFX_BUGGER_JUMP)

        e.vx = clamp(e.facing_left ? -speed : speed, e.vx - BUGGER_ACCEL, e.vx + BUGGER_ACCEL)

        e.ground_frames += 1
    else:
        e.ground_frames = 0


    if level_move_box_x(e.sx, e.box, e.vx):
        if e.on_ground:
            if e.mode == BUGGER_MODE_WALK:
                e.wait_countdown = 20
                e.wait_turn      = true
            else:
                # walk away from the wall
                e.facing_left = e.vx > 0
                e.no_turn_countdown = 30
            e.vx = 0
        else:
            e.vx = -e.vx

    e.vy += GRAVITY
    e.vy = min(e.vy, SP * 4)
    e.on_ground = false
    var d = level_move_box_y(e.sy, e.box, e.vy, false)
    if d == DIR_DOWN:
        e.on_ground = true
        e.vy = 0
    elif d == DIR_UP:
        e.vy = 8

    var t = level_get_tile(e.box.x, e.box.y)
    if t == 'L':
        enemy_kill(e)
        e.vy = 4

    # animation
    if not e.on_ground:
        e.frame = e.vy < 0 ? 5 : 6
        if abs(e.vy) < 10: e.frame = 4
    elif e.mode == BUGGER_MODE_SLEEP: e.frame = 7
    elif e.wait_countdown > 0: e.frame = 0
    else:
        e.anim_tick += 1
        var rate = e.mode == BUGGER_MODE_WALK ? 8 : 4
        e.frame = 1 + e.anim_tick / rate % 4


# ---------------------------------------------------------------------------
# cannon
# ---------------------------------------------------------------------------
const AIMED_BULLET_SPEED  = 18
const CANNON_LOS_LATCH    = 25
const CANNON_BURST_FRAMES = 60

func enemy_cannon_update(e: Enemy*):
    var mx = e.facing_left ? e.box.x : e.box.x + e.box.w - 1
    var my = box_center_y(e.box)
    var hx = box_center_x(hero.box)
    var hy = box_center_y(hero.box)
    var loc = (hero.state == HERO_STATE_NORMAL
        and box_encloses(camera.box, e.box)
        and level_has_los(mx, my, hx, hy))

    e.frame = 0
    if e.aim_countdown > 0:
        e.frame = e.aim_countdown / 5 % 4
        if e.aim_countdown == 60 or e.aim_countdown == 40 or e.aim_countdown == 20:
            particle_spawn(PARTICLE_TYPE_CHARGE, mx, my)
        if e.aim_countdown == 55 or e.aim_countdown == 35 or e.aim_countdown == 15:
            var dx = hx - mx
            var dy = hy - my
            var len = sqrt(dx * dx + dy * dy)
            if len < 1: len = 1
            var b = enemy_bullet_spawn(ENEMY_BULLET_TYPE_AIMED, mx - 1, my - 1)
            if b:
                b.vx = dx * AIMED_BULLET_SPEED / len
                b.vy = dy * AIMED_BULLET_SPEED / len
                audio_play_sfx(SFX_CANNON_SHOOT)
        e.aim_countdown -= 1
        if e.aim_countdown == 0:
            e.shoot_countdown = 120
            e.pace_countdown = 0

    elif e.shoot_countdown > 0:
        e.shoot_countdown -= 1
        e.pace_countdown = 0

    elif loc:
        e.pace_countdown += 1
        if e.pace_countdown >= CANNON_LOS_LATCH:
            e.aim_countdown = CANNON_BURST_FRAMES
            e.pace_countdown = 0
    else:
        e.pace_countdown = 0


# ---------------------------------------------------------------------------
# jelly
# ---------------------------------------------------------------------------
const JELLY_AIM_FRAMES    = 25
const JELLY_COOLDOWN      = 120
const JELLY_WAVE          = 53   # vy swings between +-this, 1 per frame: 106 frames per half wave
const JELLY_MAX_SPEED     = 6    # moves at most this fast: it glides through the middle of the wave

func enemy_jelly_update(e: Enemy*):
    e.frame = e.anim_tick / 5 % 5
    e.vy += e.anim_tick / (JELLY_WAVE * 2) % 2 ? 1 : -1
    level_move_box_y(&e.sy, &e.box, clamp(e.vy, -JELLY_MAX_SPEED, JELLY_MAX_SPEED), true)
    e.anim_tick += 1

    var cx = box_center_x(e.box)
    var cy = box_center_y(e.box)
    var hx = box_center_x(hero.box)
    var hy = box_center_y(hero.box)
    var loc = (hero.state == HERO_STATE_NORMAL
        and box_encloses(camera.box, e.box)
        and level_has_los(cx, cy, hx, hy))

    if e.charge:
        e.charge.sx = cx * SP
        e.charge.sy = cy * SP
        if e.charge.ttl <= 0: e.charge = null

    if e.shoot_countdown > 0:
        e.shoot_countdown -= 1
        if e.shoot_countdown == 0:
            e.pace_countdown = 10
    elif e.pace_countdown > 0:
        if not loc: e.pace_countdown = 10
        else:
            e.pace_countdown -= 1
            if e.pace_countdown == 0:
                e.aim_countdown = 10
                e.charge = particle_spawn(PARTICLE_TYPE_CHARGE, cx, cy)
                audio_play_sfx(SFX_CHARGE)

    elif e.aim_countdown > 0:
        e.aim_countdown -= 1
        if e.aim_countdown == 0:
            e.shoot_countdown = 120
            var dx = hx - cx
            var dy = hy - cy
            var len = sqrt(dx * dx + dy * dy)
            if len < 1: len = 1
            var b = enemy_bullet_spawn(ENEMY_BULLET_TYPE_AIMED, cx - 1, cy - 1)
            if b:
                b.vx = dx * AIMED_BULLET_SPEED / len
                b.vy = dy * AIMED_BULLET_SPEED / len
                audio_play_sfx(SFX_CANNON_SHOOT)



# ---------------------------------------------------------------------------
# piñata
# ---------------------------------------------------------------------------

const PINATA_HP    = 8
const PINATA_SPEED = 10
const PINATA_WAVE  = 16

# back and forth between walls, on a wave: the vertical speed ramps up and down
func enemy_pinata_update(e: Enemy*):
    e.frame = e.anim_tick / 8 % 4
    var dx = e.sx - e.home_sx
    if   dx >  40 * SP: e.facing_left = true
    elif dx < -40 * SP: e.facing_left = false
    if e.anim_tick % 2 == 0: e.vx = clamp(e.vx + (e.facing_left ? -1 : 1), -PINATA_SPEED, PINATA_SPEED)

    if level_move_box_x(&e.sx, &e.box, e.vx):
        e.facing_left = not e.facing_left
        e.vx = 0
    e.vy += e.anim_tick / (PINATA_WAVE * 2) % 2 ? 1 : -1
    level_move_box_y(&e.sy, &e.box, e.vy, true)
    e.anim_tick += 1


# ---------------------------------------------------------------------------
# crawler
# ---------------------------------------------------------------------------
const CRAWLER_SPEED      = 6    # in 1/SP pixels per frame
const CRAWLER_DROP_RANGE = 10   # drops when the hero's center is this close horizontally
const CRAWLER_DROP_DELAY = 8    # frames it holds still before letting go

# stick to the first solid side of tile (c, r): below, above, left, right; heading either way
func enemy_crawler_attach(e: Enemy*, c, r):
    var gx = 0
    var gy = 1
    if   level_is_solid(level_get_tile_at_cr(c, r + 1)): gy = 1
    elif level_is_solid(level_get_tile_at_cr(c, r - 1)): gy = -1
    elif level_is_solid(level_get_tile_at_cr(c - 1, r)):
        gx = -1
        gy = 0
    elif level_is_solid(level_get_tile_at_cr(c + 1, r)):
        gx = 1
        gy = 0
    e.mode     = rand(0, 1) * 2 - 1
    e.anim_tick = rand(0, 23)   # out of step with the others: 4 frames of 6 ticks
    e.crawl_dx =  gy * e.mode
    e.crawl_dy = -gx * e.mode
    e.box.x = c * TS + 3 + 3 * gx
    e.box.y = r * TS + 3 + 3 * gy
    e.sx = e.box.x * SP
    e.sy = e.box.y * SP
    e.on_ground = true

# move one pixel, like any enemy: jump-throughs (^, moving platforms) stop it only going down;
# true if something was in the way
func enemy_crawler_move(e: Enemy*, dx, dy) int:
    e.sx = e.box.x * SP
    e.sy = e.box.y * SP
    if dx: return level_move_box_x(&e.sx, &e.box, dx * SP)
    return level_move_box_y(&e.sy, &e.box, dy * SP, false)

func enemy_crawler_update(e: Enemy*):
    # fell in, or crawled down into a lava pit
    var t = level_get_tile(e.box.x, e.box.y)
    if t == 'L':
        enemy_kill(e)
        e.vy = 4
        return

    e.anim_tick += 1
    e.frame = 1 + e.anim_tick / 6 % 4

    # falling
    if not e.on_ground:
        e.frame = 0
        e.vy = min(e.vy + GRAVITY, SP * 4)
        if level_move_box_y(&e.sy, &e.box, e.vy, false) == DIR_DOWN:   # lands on jump-throughs too
            # land on the floor, heading for the hero
            audio_play_sfx(SFX_CRAWLER_LAND)
            e.on_ground = true
            e.crawl_dx  = box_center_x(hero.box) < box_center_x(e.box) ? -1 : 1
            e.crawl_dy  = 0
            e.mode      = e.crawl_dx
            e.pace_countdown = 0
        return

    # about to let go: hold still
    if e.wait_countdown > 0:
        e.frame = 0
        e.wait_countdown -= 1
        if e.wait_countdown == 0:
            audio_play_sfx(SFX_CRAWLER_DROP)
            e.on_ground = false
            e.vy = 0
            e.sx = e.box.x * SP
            e.sy = e.box.y * SP
        return

    # on the ceiling (surface above) with the hero right below: let go
    var cx = box_center_x(e.box)
    var cy = box_center_y(e.box)
    if (e.crawl_dx * e.mode < 0
    and hero.state == HERO_STATE_NORMAL
    and hero.box.y > e.box.y
    and box_encloses(camera.box, e.box)
    and abs(box_center_x(hero.box) - cx) < CRAWLER_DROP_RANGE
    and level_has_los(cx, cy, box_center_x(hero.box), box_center_y(hero.box))):
        e.wait_countdown = CRAWLER_DROP_DELAY
        return

    e.pace_countdown += CRAWLER_SPEED
    while e.pace_countdown >= SP:
        e.pace_countdown -= SP
        var dx = e.crawl_dx
        var dy = e.crawl_dy
        var gx = -dy * e.mode   # where it holds on
        var gy =  dx * e.mode
        if enemy_crawler_move(e, dx, dy):
            # a wall ahead: climb it
            e.crawl_dx = -gx
            e.crawl_dy = -gy
        elif not enemy_crawler_move(e, gx, gy):   # else still holding on
            if enemy_crawler_move(e, -dx, -dy):
                # past an edge: round the corner
                e.crawl_dx = gx
                e.crawl_dy = gy
            else:
                # nothing to go round: the end of a jump-through, or its hold is gone (block shot away)
                enemy_crawler_move(e, -gx, -gy)
                if not enemy_crawler_move(e, gx, gy):
                    e.wait_countdown = 1
                    return
                e.crawl_dx = -dx
                e.crawl_dy = -dy
                e.mode     = -e.mode

    e.sx = e.box.x * SP
    e.sy = e.box.y * SP



# ---------------------------------------------------------------------------
# mine
# ---------------------------------------------------------------------------
# floats in a straight line, bouncing off walls like a ball; dies in a burst of 8 bullets
const MINE_SPEED        = 8    # subpixels per frame
const MINE_BULLET_SPEED = 16
const MINE_BOUNCE_PAUSE = 8    # frames it sits against a wall before it bounces off (that axis only)

# (dx, dy) is one of the 8 directions, or (0, 0); diagonals as fast as straight lines (7/10 ~ 1/sqrt(2))
func enemy_mine_set_velocity(vx: int*, vy: int*, dx, dy, speed):
    if dx and dy: speed = speed * 7 / 10
    vx.* = dx * speed
    vy.* = dy * speed

func enemy_mine_update(e: Enemy*):
    e.frame = e.anim_tick / 8 % 6
    e.anim_tick += 1
    # a pause per axis: wait_countdown for x, pace_countdown for y
    if e.wait_countdown > 0:
        e.wait_countdown -= 1
        if e.wait_countdown == 0: e.vx = -e.vx
    elif level_move_box_x(&e.sx, &e.box, e.vx):
        e.wait_countdown = MINE_BOUNCE_PAUSE
    if e.pace_countdown > 0:
        e.pace_countdown -= 1
        if e.pace_countdown == 0: e.vy = -e.vy
    elif level_move_box_y(&e.sy, &e.box, e.vy, true):
        e.pace_countdown = MINE_BOUNCE_PAUSE

func enemy_mine_burst(e: Enemy*):
    var x = box_center_x(e.box) - 3
    var y = box_center_y(e.box) - 3
    for d = 0, 9:
        if d == 4: continue
        var b = enemy_bullet_spawn(ENEMY_BULLET_TYPE_ORB, x, y)
        if b: enemy_mine_set_velocity(&b.vx, &b.vy, d % 3 - 1, d / 3 - 1, MINE_BULLET_SPEED)
