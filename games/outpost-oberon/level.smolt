# moving platform: a row of 'V' tiles in the level data moves up and down, a row of 'H' tiles left
# and right; through free tiles, turning around on a '.', on a solid tile (V) or before one (H)
const PLATFORM_NONE = 0   # free slot
const PLATFORM_V    = 1
const PLATFORM_H    = 2

struct Platform:
    type
    box: Box     # the surface you stand on: box.y is the top, 1 pixel high
    sx           # box position in subpixels
    sy
    vx           # one of them is 0
    vy
    range: Box   # where the box may go
    wait         # frames to pause before moving on

# blocks: solid tiles that can be destroyed. While gone, their tile in level.data is ' '.
# boom block: standing on it or shooting it lights a fuse; it explodes,
#   lights its neighbours (chain reaction) and comes back later.
# treasure: the hero shoots it open; it breaks for good and out comes the helmet.
const BLOCK_NONE     = 0
const BLOCK_BOOM     = 1   # 'B' tile
const BLOCK_TREASURE = 2   # 'T' tile

struct Block:
    type
    i           # index into level.data
    x           # pixels
    y
    countdown   # boom, while 'B': frames until it explodes, 0 = fuse not lit; while gone: frames until it is back
                # treasure: frames of the white hit flash
    hp          # treasure: hp left, in hero bullet power

const BOOM_BLOCK_FUSE      = 96   # after the hero stands on it; 4 fuse loops of 24 frames
const BOOM_BLOCK_SHOT_FUSE = 6    # after it was shot or a neighbour exploded
const BOOM_BLOCK_RESPAWN   = 240  # frames until it is back, including:
const BOOM_BLOCK_GROW      = 24   # the last frames, where it grows back
const TREASURE_HP          = 8    # 4 normal shots

const PLATFORM_SPEED = 8   # subpixels per frame: half a pixel
const PLATFORM_WAIT  = 60  # pause at each end, in frames

# pickups: placed in the level, or dropped (by piñatas): those fly off like debris, bouncing off walls,
# stop dead, hover and bob, and blink out after a while
const PICKUP_NONE    = 0   # a free slot
const PICKUP_HELMET  = 1   # '+' tile
const PICKUP_QUANTUM = 2   # '*' tile

struct Pickup:
    type
    box: Box   # the hit box; the sprite is centred on it
    sx         # box position in subpixels
    sy
    vx
    vy
    ty      # dropped: the flight ends once it falls back below this (box y), so it never stops out of reach
    ttl     # dropped: frames until it's gone; placed: 0, stays

const PICKUP_DROP_FRAMES  = 900  # 15 s: long enough to come back for, too short to bank as a spare life
const PICKUP_FLY_FRAMES   = 64   # the first frames, where a dropped one flies; most stop early, on ty
const PICKUP_BLINK_FRAMES = 60   # the last frames before a dropped one is gone

const HELMET_SCORE   = 100
const QUANTA_START   = 30
const QUANTA_RESPAWN = 10   # paid on each respawn; all that's left if fewer
const QUANTUM_SCORE  = 10
const QUANTUM_MAGNET_RANGE = 32   # pixels
const QUANTUM_MAGNET_SPEED = 32   # subpixels per frame, right next to the hero
const QUANTUM_BONUS  = 50   # per quantum left over at the end of the game

struct Level:
    data: int*
    w
    h
    spawn_x
    spawn_y
    tick
    checkpoints: Vec[10]
    checkpoint_count
    active_checkpoint: Vec*
    checkpoint_tick
    platforms: Platform[10]
    blocks: Block[100]
    pickups: Pickup[100]

var level: Level


func level_init(data: int*):
    # put back the blocks the previous level left destroyed (level data is reused)
    for b in level.blocks:
        if b.type != BLOCK_NONE: level.data[b.i] = b.type == BLOCK_BOOM ? 'B' : 'T'
    level.data = data
    level.w    = stridx(data, 'X') + 1
    level.h    = strlen(data) / level.w
    level.tick = 0

    # spawn pos
    var i = stridx(level.data, 'h')
    if i >= 0:
        level.spawn_x = i % level.w * TS + 8
        level.spawn_y = i / level.w * TS + 16
    else:
        i = stridx(level.data, 'S')
        var l = 1
        while level.data[i] == 'S':
            i += 1
            l += 1
        level.spawn_x = i % level.w * TS - l  * TS / 2 + 8
        level.spawn_y = i / level.w * TS + 20

    # set up checkpoints, blocks, pickups and platforms
    level.active_checkpoint = null
    level.checkpoint_count = 0
    for b in level.blocks: b.* = {}
    for p in level.pickups: p.* = {}
    for p in level.platforms: p.* = {}
    for r = 0, level.h:
        for c = 0, level.w:
            var t = level_get_tile_at_cr(c, r)
            if t == 'C':
                if level.checkpoint_count >= level.checkpoints.len:
                    print("error: not enough checkpoints")
                    continue
                level.checkpoints[level.checkpoint_count] = { c * TS, r * TS }
                level.checkpoint_count += 1
            elif t == 'B' or t == 'T':
                level_add_block(t == 'B' ? BLOCK_BOOM : BLOCK_TREASURE, c, r)
            elif t == '+' or t == '*':
                level_add_pickup(t == '+' ? PICKUP_HELMET : PICKUP_QUANTUM, c * TS + 8, r * TS + 8)
            elif (t == 'V' or t == 'H') and level_get_tile_at_cr(c - 1, r) != t:  # each run is one platform
                var n = 1
                while level_get_tile_at_cr(c + n, r) == t: n += 1
                level_add_platform(t == 'V' ? PLATFORM_V : PLATFORM_H, c, r, n)


func level_add_block(type, c, r):
    for b in level.blocks:
        if b.type != BLOCK_NONE: continue
        b.* = { type, c + r * level.w, c * TS, r * TS, 0, TREASURE_HP }
        return
    print("error: not enough blocks")


# a placed pickup, centred on (x, y)
func level_add_pickup(type, x, y) Pickup*:
    for p in level.pickups:
        if p.type != PICKUP_NONE: continue
        p.* = { type, { x - 4, y - 4, 8, 8 } }
        p.sx = p.box.x * SP
        p.sy = p.box.y * SP
        return p
    print("error: not enough pickups")
    return null

# a pickup bursting out of something destroyed (a piñata), centred on (x, y)
func level_drop_pickup(type, x, y):
    var p = level_add_pickup(type, x, y)
    if not p: return
    p.ttl = PICKUP_DROP_FRAMES
    p.vx  = rand(-18, 18)
    p.vy  = rand(-28, -8)
    p.ty  = p.box.y + rand(-4, 12)


func level_add_platform(type, c, r, n):
    for p in level.platforms:
        if p.type != PLATFORM_NONE: continue
        p.* = { type, { c * TS, r * TS, n * TS, 1 }, c * TS * SP, r * TS * SP }
        p.range = p.box
        if type == PLATFORM_V:
            var up   = level_platform_reach(c, r, n, 0, -1)
            var down = level_platform_reach(c, r, n, 0, 1)
            p.range.y -= up * TS
            p.range.h += (up + down) * TS
            p.vy = PLATFORM_SPEED
        else:
            var left  = level_platform_reach(c, r, n, -1, 0)
            var right = level_platform_reach(c, r, n, 1, 0)
            p.range.x -= left * TS
            p.range.w += (left + right) * TS
            p.vx = PLATFORM_SPEED
        return
    print("error: not enough platforms")

# how many tiles the platform at row r, columns c to c + n - 1, can travel in direction (dc, dr):
# onto the next '.'; up and down also into a solid tile (it disappears into it: walls are drawn
# over it), sideways only up to one
func level_platform_reach(c, r, n, dc, dr) int:
    var k = 0
    while true:
        k += 1
        var stop = false
        for i = 0, dr ? n : 1:   # the tiles it moves into: the next row, or the next column
            var t = level_get_tile_at_cr(c + i, r + k * dr)
            if dc: t = level_get_tile_at_cr((dc < 0 ? c : c + n - 1) + k * dc, r)
            if level_is_solid(t):
                if dc: return k - 1
                stop = true
            if t == '.': stop = true
        if stop: return k


func level_platform_carry(sx: int*, sy: int*, box: Box*, dx, dy):
    if dx: level_move_box_x(sx, box, dx * SP)
    if dy: level_move_box_y(sy, box, dy * SP, true)

func level_platform_supports(p: Platform*, b: Box*) int:
    return b.y + b.h == p.box.y and b.x < p.box.x + p.box.w and b.x + b.w > p.box.x


func level_get_tile_at_cr(c, r):
    if c < 0 or c >= level.w: return '0'
    if r < 0 or r >= level.h: return '0'
    c = level.data[c + r * level.w]
    if c == 'X': return '0'
    return c

func level_get_tile(x, y):
    return level_get_tile_at_cr(x / TS, y / TS)

func level_is_solid(t):
    return t == '0' or t == 'X' or t == 'B' or t == 'T'

# something hit the block at (x, y), if there is one: a boom block lights its fuse;
# a treasure block takes damage, but only from the hero: power is a hero bullet's, else 0
func level_hit_block(x, y, power):
    var i = x / TS + y / TS * level.w
    if level.data[i] == ' ': return   # gone (or no block at all)
    for b in level.blocks:
        if b.i != i: continue
        if b.type == BLOCK_BOOM:
            if b.countdown == 0 or b.countdown > BOOM_BLOCK_SHOT_FUSE: b.countdown = BOOM_BLOCK_SHOT_FUSE
        elif b.type == BLOCK_TREASURE and power > 0:
            b.hp -= power
            b.countdown = 3
            if b.hp > 0:
                audio_play_sfx(SFX_ENEMY_HIT)
                return
            # broken: clear the tile first, so the helmet appears in free space
            level.data[b.i] = ' '
            b.countdown = 0
            audio_play_sfx(SFX_EXPLOSION)
            particle_spawn(PARTICLE_TYPE_EXPLOSION, b.x + 8, b.y + 8)
            for k = 0, 16: particle_spawn(PARTICLE_TYPE_DEBRIS, b.x + rand(0, TS - 1), b.y + rand(0, TS - 1))
            level_drop_pickup(PICKUP_HELMET, b.x + 8, b.y + 8)
        return


func level_has_los(x0, y0, x1, y1):
    var c0 = x0 / TS
    var r0 = y0 / TS
    var c1 = x1 / TS
    var r1 = y1 / TS
    if c0 == c1 and r0 == r1: return true

    var dx = x1 - x0
    var dy = y1 - y0
    var steps = abs(dx)
    if abs(dy) > steps: steps = abs(dy)

    var i = 1
    while i <= steps:
        var x = x0 + dx * i / steps
        var y = y0 + dy * i / steps
        var tc = x / TS
        var tr = y / TS
        if (tc != c0 or tr != r0) and (tc != c1 or tr != r1):
            if level_is_solid(level_get_tile_at_cr(tc, tr)): return false
        i += 1
    return true


# debug collision probes (flushed each frame via level_draw_dots)
struct LevelDot:
    x
    y
var level_dots: LevelDot[256]
var level_dot_count

func level_dot(x, y):
    return # XXX
    level_dots[level_dot_count] = {x, y}
    level_dot_count += 1

func level_draw_dots():
    for i = 0, level_dot_count:
        var d = level_dots[i]
        camera_sprite(d.x, d.y, 1, 1, 13, 24, 0)
    level_dot_count = 0


# collision
const DIR_LEFT  = 1
const DIR_RIGHT = 2
const DIR_UP    = 3
const DIR_DOWN  = 4

func level_test(x, y, dir) int:
    level_dot(x, y)
    if not level_is_solid(level_get_tile(x, y)): return 0
    if dir == DIR_LEFT:  return TS - (x % TS)
    if dir == DIR_RIGHT: return -1 - (x % TS)
    if dir == DIR_UP:    return TS - (y % TS)
    if dir == DIR_DOWN:  return -1 - (y % TS)

func level_test_down(x, y, py) int:
    level_dot(x, y)
    var o = 0
    var t = level_get_tile(x, y)
    if (level_is_solid(t) or
        t == '^' and (y / TS) > (py / TS)):
        o = -1 - (y % TS)
    # platforms are jump-through: only land when moving down from above.
    # A rising platform (1 px per frame at most) may have just moved into py: that counts as above too.
    # Not for one going down: it would pop up whoever it sinks past (e.g. into the floor they stand on)
    for p in level.platforms:
        if p.type == PLATFORM_NONE: continue
        var top = p.box.y
        var above = py < top or py == top and p.vy < 0
        if x >= p.box.x and x < p.box.x + p.box.w and py < y and above and y >= top and top - 1 - y < o:
            o = top - 1 - y
    return o

# Resolve axis motion for enemy boxes. Mutates sx/sy and box.x/box.y.
# Probes: two points on the leading face (simple; not hero-grade).
func level_move_box_x(sx: int*, box: Box*, dx) int:
    sx.* = sx.* + dx
    var x = sx.* / SP
    if x == box.x: return 0

    var y1 = box.y + box.h - 1
    var o
    if dx < 0:
        o = max(level_test(x, box.y, DIR_LEFT), level_test(x, y1, DIR_LEFT))
        if o:
            x += o
            sx.* = x * SP
            box.x = x
            return DIR_LEFT
    else:
        o = min(level_test(x + box.w - 1, box.y, DIR_RIGHT),
                level_test(x + box.w - 1, y1, DIR_RIGHT))
        if o:
            x += o
            sx.* = x * SP + SP - 1
            box.x = sx.* / SP
            return DIR_RIGHT
    box.x = x
    return 0


func level_move_box_y(sy: int*, box: Box*, dy, pass_platforms) int:
    sy.* = sy.* + dy
    var y = sy.* / SP
    if y == box.y: return 0

    var x1 = box.x + box.w - 1
    var o
    if dy > 0:
        var foot = y + box.h - 1
        var py = pass_platforms ? foot : box.y + box.h - 1
        o = min(level_test_down(box.x, foot, py), level_test_down(x1, foot, py))
        if o:
            y += o
            sy.* = y * SP + SP - 1
            box.y = sy.* / SP
            return DIR_DOWN
    else:
        o = max(level_test(box.x, y, DIR_UP), level_test(x1, y, DIR_UP))
        if o:
            y += o
            sy.* = y * SP
            box.y = y
            return DIR_UP
    box.y = y
    return 0



func level_update():
    # moving platforms
    for p in level.platforms:
        if p.type == PLATFORM_NONE: continue
        if p.wait > 0:
            p.wait -= 1
            continue
        # at the end of the range it is heading for, turn around (checked before moving: it moves
        # at most 1 pixel per frame, so it can't step out, even when it starts at an end)
        var r = p.range
        if (p.vx < 0 and p.box.x == r.x or p.vx > 0 and p.box.x + p.box.w == r.x + r.w or
            p.vy < 0 and p.box.y == r.y or p.vy > 0 and p.box.y + p.box.h == r.y + r.h):
            p.vx = -p.vx
            p.vy = -p.vy
            p.wait = PLATFORM_WAIT
            continue
        p.sx += p.vx
        p.sy += p.vy
        var dx = p.sx / SP - p.box.x
        var dy = p.sy / SP - p.box.y
        if not dx and not dy: continue

        # carry whatever stands on it; walls and ceilings stop it (the platform moves on into them)
        if hero.state == HERO_STATE_NORMAL and hero.on_ground and level_platform_supports(p, hero.box):
            var x = hero.box.x
            var y = hero.box.y
            level_platform_carry(hero.sx, hero.sy, hero.box, dx, dy)
            for c in cape:   # sideways only half: the cape trails a little, as in a light breeze
                c.sx  += (hero.box.x - x) * SP / 2
                c.psx += (hero.box.x - x) * SP / 2
                c.sy  += (hero.box.y - y) * SP   # up and down: previous positions too, so the move adds no swing
                c.psy += (hero.box.y - y) * SP

        for e in enemies:
            if e.state == ENEMY_STATE_NORMAL and e.on_ground and level_platform_supports(p, e.box):
                level_platform_carry(e.sx, e.sy, e.box, dx, dy)
        p.box.x += dx
        p.box.y += dy

    # blocks
    for b in level.blocks:
        if b.type == BLOCK_TREASURE:
            if b.countdown > 0: b.countdown -= 1
            continue
        if b.type != BLOCK_BOOM: continue
        var box: Box = { b.x, b.y, TS, TS }
        if level.data[b.i] == 'B':
            if (b.countdown == 0 and hero.state == HERO_STATE_NORMAL and hero.on_ground
                and hero.box.y + hero.box.h == b.y and hero.box.x < b.x + TS and hero.box.x + hero.box.w > b.x):
                b.countdown = BOOM_BLOCK_FUSE
            if b.countdown > 0:
                b.countdown -= 1
                # beep as each red pulse starts from the centre (frame 1 of the fuse loop)
                if b.countdown % 24 == 23: audio_play_sfx(SFX_BOOM_BEEP)
                if b.countdown == 0:
                    level.data[b.i] = ' '
                    b.countdown = BOOM_BLOCK_RESPAWN
                    audio_play_sfx(SFX_BOOM)
                    camera.shake = 40
                    particle_spawn(PARTICLE_TYPE_BLAST, b.x + 8, b.y + 8)
                    particle_spawn(PARTICLE_TYPE_EXPLOSION, b.x + 8, b.y + 8)
                    # the blast hurts everything within 4 pixels of the block
                    var blast: Box = { b.x - 4, b.y - 4, TS + 8, TS + 8 }
                    if hero_can_take_damage() and box_intersects(blast, hero.box): hero_hurt()
                    for e in enemies:
                        if e.state == ENEMY_STATE_NORMAL and box_intersects(blast, e.box): enemy_kill(e)
                    for k = 0, 16: particle_spawn(PARTICLE_TYPE_DEBRIS, b.x + rand(0, TS - 1), b.y + rand(0, TS - 1))
                    # chain reaction
                    level_hit_block(b.x - TS, b.y, 0)
                    level_hit_block(b.x + TS, b.y, 0)
                    level_hit_block(b.x, b.y - TS, 0)
                    level_hit_block(b.x, b.y + TS, 0)
        else:
            b.countdown -= 1
            if b.countdown == 0:
                # back, fragging whatever is in the way
                level.data[b.i] = 'B'
                if hero.state == HERO_STATE_NORMAL and box_intersects(box, hero.box): hero_set_state(HERO_STATE_DYING)
                for e in enemies:
                    if e.state == ENEMY_STATE_NORMAL and box_intersects(box, e.box): enemy_kill(e)

    for p in level.pickups:
        if p.type == PICKUP_NONE: continue
        if p.ttl > 0:
            p.ttl -= 1
            if p.ttl == 0:
                p.type = PICKUP_NONE
                continue

        # velocity: a dropped one flies like debris at first; then it hovers, except that quanta
        # are a bit magnetic: near the hero they drift toward it, the closer the faster
        var flying = p.ttl > PICKUP_DROP_FRAMES - PICKUP_FLY_FRAMES
        if flying: p.vy += GRAVITY / 2
        else:
            p.vx = 0
            p.vy = 0
            if p.type == PICKUP_QUANTUM and hero.state == HERO_STATE_NORMAL:
                var dx = box_center_x(hero.box) - box_center_x(p.box)
                var dy = box_center_y(hero.box) - box_center_y(p.box)
                var d  = sqrt(dx * dx + dy * dy)
                if d < QUANTUM_MAGNET_RANGE:
                    var v = QUANTUM_MAGNET_SPEED * (QUANTUM_MAGNET_RANGE - d) / QUANTUM_MAGNET_RANGE
                    p.vx = dx * v / max(d, 1)
                    p.vy = dy * v / max(d, 1)

        # move; flying, it bounces off walls and lands on platforms
        var hit_x = level_move_box_x(&p.sx, &p.box, p.vx)
        var hit_y = level_move_box_y(&p.sy, &p.box, p.vy, not flying)
        if flying:
            if hit_x: p.vx *= -1
            if hit_y: p.vy = p.vy * -7 / 10
            # back down at its target height: stop dead
            if p.vy > 0 and p.box.y >= p.ty: p.ttl = PICKUP_DROP_FRAMES - PICKUP_FLY_FRAMES

        if hero.state != HERO_STATE_NORMAL or not box_intersects(p.box, hero.box): continue
        if p.type == PICKUP_HELMET:
            hero.score += HELMET_SCORE
            hero.helmet = true
            for k = 0, 3:
                var s = particle_spawn(PARTICLE_TYPE_SPARKLE, p.box.x + rand(0, p.box.w - 1), p.box.y + rand(0, p.box.h - 1))
                if s: s.ttl += k * 4
            audio_play_sfx(SFX_PICKUP_HELMET)
        else:
            hero.quanta += 1
            hero.score += QUANTUM_SCORE
            particle_spawn(PARTICLE_TYPE_SPARKLE, box_center_x(p.box), box_center_y(p.box))
            audio_play_sfx(SFX_PICKUP_QUANTUM)
        p.type = PICKUP_NONE

    if hero.state == HERO_STATE_NORMAL:
        for i = 0, level.checkpoint_count:
            var cp = &level.checkpoints[i]
            if cp == level.active_checkpoint: continue
            var box: Box = { cp.x + 8, cp.y - TS, 1, TS * 3 }
            if box_intersects(box, hero.box):
                level.active_checkpoint = cp
                level.checkpoint_tick = 0
                level.spawn_x = cp.x + 8
                level.spawn_y = cp.y + 16
                audio_play_sfx(SFX_CHECKPOINT)

    level.tick += 1
    level.checkpoint_tick += 1



const STAR_N   = 800
const PERIOD_W = 1000
const PERIOD_H = 1000

func level_draw_background():
    # hashed starfield (deterministic; period 1000×1000)
    var ox = camera.box.x / 3
    var oy = camera.box.y / 3
    for i = 0, STAR_N:
        var px = (i * (i * 7919 + 104729) + 12345) % PERIOD_W
        var py = (i * (i * 6971 + 224737) + 67890) % PERIOD_H
        var sx = (px - ox) % PERIOD_W
        var sy = (py - oy) % PERIOD_H
        if sx < SCREEN_W and sy < SCREEN_H:
            var g = (i * (i + 19)) % 3
            var grey = g == 0 ? 43 : g == 1 ? 44 : 47
            sprite(sx, sy, 1, 1, 0, grey, 0)

    var c0 = camera.box.x / TS
    var r0 = camera.box.y / TS
    for r = r0, r0 + SCREEN_H / TS + 2:
        for c = c0, c0 + SCREEN_W / TS + 1:
            var t = level_get_tile_at_cr(c, r)
            var x = c * TS - camera.box.x
            var y = r * TS - camera.box.y

            if t == '^':  # jump through platform
                sprite(x, y, TS, TS, 4 * TS, 48, 0)

            elif t == 'E':
                var q = level.tick * 2 % 32
                for i = 0, 32:
                    q = (q + 5) % 31
                    var color = q >= i ? 0 : q > 10 ? 3 : 6
                    if color: sprite(x, y + i - 16, TS, 1, 0, 32 + color, 0)

            elif t == 'S':
                var q = level.tick * 2 % 32
                for i = 0, 32:
                    q = (q + 5) % 31
                    var color = q >= i ? 0 : q > 10 ? 3 : 6
                    if color: sprite(x, y + 31 - i, TS, 1, 0, 32 + color, 0)

    for p in level.platforms:
        if p.type == PLATFORM_NONE: continue
        for x = 0, p.box.w / TS:
            camera_sprite(p.box.x + x * TS, p.box.y, TS, TS, 4 * TS, 48, 0)

    if level.active_checkpoint:
        var x = level.active_checkpoint.x
        var y = level.active_checkpoint.y
        var q = level.checkpoint_tick * 2 % 32
        for i = 0, 32:
            q = (q + 5) % 31
            var color = q >= min(i, level.checkpoint_tick / 4) or q > 10 ? 0 : 3
            if color: camera_sprite(x, y + i - 16, TS, 1, 0, 32 + color, 0)


func level_draw_walls():
    var c0 = camera.box.x / TS
    var r0 = camera.box.y / TS
    for r = r0, r0 + SCREEN_H / TS + 2:
        for c = c0, c0 + SCREEN_W / TS + 1:
            var t = level_get_tile_at_cr(c, r)
            var x = c * TS - camera.box.x
            var y = r * TS - camera.box.y

            if t == '0':
                # edge
                sprite(x, y, TS, TS, 16, 32, 0)
                if level_get_tile_at_cr(c - 1, r) != '0': sprite(x, y, TS, TS, 0 * TS, 48, 0)
                if level_get_tile_at_cr(c + 1, r) != '0': sprite(x, y, TS, TS, 1 * TS, 48, 0)
                if level_get_tile_at_cr(c, r - 1) != '0': sprite(x, y, TS, TS, 2 * TS, 48, 0)
                if level_get_tile_at_cr(c, r + 1) != '0': sprite(x, y, TS, TS, 3 * TS, 48, 0)

            elif t == 'L':  # lava
                sprite(x, y, TS, TS, 5 * TS, 48, 0)
            elif t == 'l':  # lava surface
                var f = (level.tick + c * 25) / 6 % 7
                sprite(x, y, TS, TS, (6 + f) * TS, 48, 0)

    for p in level.pickups:
        if p.type == PICKUP_NONE or (p.ttl > 0 and p.ttl < PICKUP_BLINK_FRAMES and p.ttl & 4): continue
        var x = p.box.x
        var y = p.box.y
        if p.type == PICKUP_HELMET:
            camera_sprite(x, y, 8, 8, level.tick / 6 % 8 * 8, 224, 0)
        else:
            camera_sprite(x, y, 8, 8, level.tick / 4 % 16 * 8, 240, 0)


    for b in level.blocks:
        if b.type == BLOCK_TREASURE:
            if level.data[b.i] == 'T': camera_sprite(b.x, b.y, TS, TS, 96 + (b.countdown > 0) * TS, 64, 0)
            continue
        if b.type != BLOCK_BOOM: continue
        if level.data[b.i] == 'B':
            var f = 0
            var dx = 0
            if b.countdown > 0:
                # while the fuse burns, loop frames 1-4, shaking at the end
                f = 4 - b.countdown / 6 % 4
                if b.countdown <= 30: dx = (b.countdown & 2) - 1
            camera_sprite(b.x + dx, b.y, TS, TS, f * TS, 64, 0)
            if b.countdown > 0 and b.countdown <= 4: camera_sprite(b.x + dx, b.y, TS, TS, 5 * TS, 64, 0)  # white flash
        elif b.countdown <= BOOM_BLOCK_GROW:
            if b.countdown & 2:
                # growing back from the centre: 2x2, 4x4, ... 16x16, flashing
                var h = TS / 2 - (b.countdown - 1) * TS / 2 / BOOM_BLOCK_GROW  # half the size: 1 to 8
                camera_sprite(b.x + TS / 2 - h, b.y + TS / 2 - h, h * 2, h * 2, 5 * TS + TS / 2 - h, 64 + TS / 2 - h, 0)
