,,,,,,,,,,,,,,,, ,,,,,,,,,,,,,,,,
i4a+,,,,,,,,a,,,,,,, i5f,g,c,=,,,,,, ,,,,,,,,
i4a+,,,,,,,,a,,,,,,, i5f,g,>c,=,c,=,,,, ,,,,,,,c,7d,
i5d+,14,,,,,,,i4f,,,,,,,, i5g,c,=,,,,,, ,,,,,,,,
i4d+,,,,,,f,,d,,,,,,,i5<a+, a+,>c,=,c<,=,,, ,,,,,,,,,



$6 a14 d6 s45 r11 T|~0,,~7,,~10,,~15,,
$7 a14 d6 s45 r11 T|~0,,~7,,~14,,~19,,
$8 a14 d6 s45 r18 T|~0,,~7,,~14,,~19,,
