# music player for composing: ./run.sh composer
# left/right: pick a song, A: play from the start, B: stop
include "lib/api.smolt"
include "lib/util.smolt"
include "lib/audio.smolt"
include "../outpost-oberon/audio_data.smolt"


var MUSIC_WIP = "
# bass
$10 d5s50r3  PW64~0F1C100,C50,C30

# lead
$20 d5s50r3 PW128w3~0,20Y3y24
$21 d5s50r16 PW128w3~0,20Y3y24
$22 w-5

@0| # drums
@1| # bass
@2| # lead



$0

@0 t6 q1 i0
| c,,,,c,,,,c,,,,c,,,,


@1 t6 q3 o2 i10
d,d,d,d,d,d,d,d, d,d,d,d,d,d,d,d,
c,c,c,c,c,c,c,c, c,c,c,c,c,c,c,c,
<a+,a+,a+,a+,a+,a+,a+,a+, a+,a+,a+,a+,a+,a+,a+,a+,>
c,c,c,c,c,c,c,c, c,c,c,c,c,c,c,c,

@2
t6 q2 o4 i20
,,,,,,<a>,,d,,e,,f,,a,,
g,,,a,,,f,,g,,,,f,,e,,
g,,,,,,f,e,j21d,,,,,,,,
,,,,=,,,,,,,,,,,,


##################

@1 t6 q3 o2 i10
d,d,d,d,d,d,d,d, d,d,d,d,d,d,d,d,
e,e,e,e,e,e,e,e, e,e,e,e,e,e,e,e,
g,g,g,g,g,g,g,g, g,g,g,g,g,g,g,g,
g,g,g,g,g,g,g,g, g,g,g,g,g,g,g,g,
a,a,a,a,a,a,a,a, a,a,a,a,a,a,a,a,
a,a,a,a,a,a,a,a, a,a,a,a,a,a,a,a,

@2
t6 q2 o4 i20
,,,,,,<a>,,*100f,,,a,,,d',, c',,,g,,=,>g,,,,e,,,c,,,
j21d,,,,,,,, ,,,,,,,, j22,,,,,,,, =,,,,f,,,t3g,f,t6
j21e,,,,,,,, ,,,,,,,, ,,,,,,,, =,,,,,,,,
"


struct Song:
    name: int*
    data: int*

var SONGS: Song[] = {
    { "WIP", MUSIC_WIP },
    { "TITLE", MUSIC_TITLE },
    { "LEVEL", MUSIC_LEVEL },
}

var song
var frame
var started

# piano roll: the last 320 frames, one column per frame, 2 px per semitone (notes 12 to 95), as heard
var roll: int[320 * 8]   # per column and track: sounding pitch (1/8 semitones) * 16 + shade, -1: silent

func roll_y(pitch) int: return 178 - (pitch - 12 * 8) / 4

func roll_record():
    var col = frame % 320
    for i = 0, 8:
        var t = &audio_tracks[i]
        var v = &t.voice
        # as in audio_update
        var pitch = v.pitch + (v.abs_pitch ? 0 : t.pitch / 8) + audio_voice_vibrato(v)
        var vol = t.row.volume * v.vol * v.level / (64 * 64)
        var shade = 15 - min(vol * 15 / AUDIO_ENV_PEAK, 15)   # 0: loudest, 15: black
        var visible = t.pos and shade < 15 and pitch >= 12 * 8 and pitch < 96 * 8
        roll[col * 8 + i] = visible ? pitch * 16 + shade : -1

func roll_draw():
    # octave lines at each C
    for c = 1, 8:
        for y = roll_y(c * 96) - 1, roll_y(c * 96) + 1:   # 2 px, like an unbent note line
            sprite(0,   y, 256, 1, 0, 31, 0)
            sprite(256, y, 256, 1, 0, 31, 0)
    for x = 0, 320:
        var f = frame - 319 + x
        if f < 0: continue
        var col = f % 320
        for i = 0, 8:
            var r = roll[col * 8 + i]
            if r < 0: continue
            # 2 px line, shifted up by the truncated quarter pixels: full middle row,
            # partial rows above and below (weight in quarters scales the gradient's brightness)
            var p = r / 16
            var y = roll_y(p)
            var q = (p - 12 * 8) % 4                             # truncated quarter pixels
            var l = 15 - r % 16                                  # 15: loudest
            sprite(x, y - 1, 1, 1, r % 16, 32 + i, 0)            # colour gradients at (0, 32)
            if q > 0: sprite(x, y - 2, 1, 1, 15 - l * q / 4, 32 + i, 0)
            sprite(x, y, 1, 1, 15 - l * (4 - q) / 4, 32 + i, 0)

func tick():
    if btnp(BTN_LEFT):  song = (song + SONGS.len - 1) % SONGS.len
    if btnp(BTN_RIGHT): song = (song + 1) % SONGS.len
    if btnp(BTN_LEFT) or btnp(BTN_RIGHT) or btnp(BTN_A) or not started:
        started = true
        frame = 0
        audio_play_music(SONGS[song].data)

    audio_update()

    draw_text(2, 2, "<     >")
    draw_text(10, 2, SONGS[song].name)

    roll_record()
    roll_draw()
    var buf: int[12]
    strnum(buf, frame / 60)
    draw_text(72, 2, buf)
    frame += 1

    input_update()
